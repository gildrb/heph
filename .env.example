# Core overrides
HEPHAION_API_KEY=your-api-key
HEPHAION_BASE_URL=https://api.example.com/v1
HEPHAION_MODEL=glm-5
HEPHAION_MAX_TOKENS=4096
HEPHAION_RAG_CONTEXT_BUDGET=2000
HEPHAION_FEATURE_FLAGS=

# Logging
HEPHAION_LOG_LEVEL=INFO
HEPHAION_LOG_FILE=/path/to/hephaion.log
HEPHAION_LOG_FORMAT=text

# Retrieval
HEPHAION_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HEPHAION_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Provider API keys
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
ZAI_API_KEY=your-zai-api-key
CUSTOM_API_KEY=your-custom-provider-api-key
