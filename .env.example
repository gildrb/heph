# Core overrides
HARNESS_API_KEY=your-api-key
HARNESS_BASE_URL=https://api.example.com/v1
HARNESS_MODEL=glm-5
HARNESS_MAX_TOKENS=4096
HARNESS_RAG_CONTEXT_BUDGET=2000
HARNESS_FEATURE_FLAGS=

# Logging
HARNESS_LOG_LEVEL=INFO
HARNESS_LOG_FILE=/path/to/harness.log
HARNESS_LOG_FORMAT=text

# Retrieval
# Provider embeddings are requested only when this is set. The model must be
# available at the configured provider's OpenAI-compatible /v1/embeddings endpoint.
# HARNESS_EMBED_MODEL=text-embedding-3-small

# Provider API keys
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
ZAI_API_KEY=your-zai-api-key
CUSTOM_API_KEY=your-custom-provider-api-key
