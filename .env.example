# Core overrides
HARNESS_API_KEY=your-api-key
HARNESS_BASE_URL=https://api.example.com/v1
HARNESS_MODEL=glm-5
HARNESS_MAX_TOKENS=4096
HARNESS_RAG_CONTEXT_BUDGET=2000
HARNESS_FEATURE_FLAGS=

# Logging
HARNESS_LOG_LEVEL=INFO
HARNESS_LOG_FILE=/path/to/harness.log
HARNESS_LOG_FORMAT=text

# Retrieval
HARNESS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HARNESS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Provider API keys
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
ZAI_API_KEY=your-zai-api-key
CUSTOM_API_KEY=your-custom-provider-api-key
