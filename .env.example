# Core overrides
HEPHAISTOS_API_KEY=your-api-key
HEPHAISTOS_BASE_URL=https://api.example.com/v1
HEPHAISTOS_MODEL=glm-5
HEPHAISTOS_MAX_TOKENS=4096
HEPHAISTOS_RAG_CONTEXT_BUDGET=2000
HEPHAISTOS_MAX_RETRIES=3
HEPHAISTOS_RETRY_BASE_DELAY=1.0
HEPHAISTOS_RETRY_MAX_DELAY=30.0

# Logging
HEPHAISTOS_LOG_LEVEL=INFO
HEPHAISTOS_LOG_FILE=/path/to/hephaistos.log
HEPHAISTOS_LOG_FORMAT=text

# Retrieval
HEPHAISTOS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HEPHAISTOS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Provider API keys
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
ZAI_API_KEY=your-zai-api-key
CUSTOM_API_KEY=your-custom-provider-api-key
